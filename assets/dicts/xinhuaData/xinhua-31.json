{"铆": [{"mǎo": [{"e": "(卯为铆的本字) 卯,榫。"}]}], "铈": [{"shì": [{"e": "稀土族中丰度最高的元素,原子序数58,以化合状态存在于独居石、铈硅石和其他稀土矿中;色泽与铁相似,但质软,有展性和延性;用钢刮擦时冒火花,制成作火石用的引火铁合金(如供打火机用) ——元素符号Ce。"}]}], "铉": [{"xuàn": [{"e": "(形声。从金,玄声。本义:举鼎的器具)。"}, {"e": "同本义 。横贯鼎两耳以举鼎的木棍。或为钩状,金属制,以提鼎两耳。"}, {"e": "比喻三公等重臣。", "w": [{"w": "铉台", "t": "本以台鼎喻三公之位,又易鼎为“铉”字,指丞相职位"}, {"w": "铉司", "t": "重臣。"}]}, {"e": "弓弦"}, {"e": "琴弦,乐器上发声的线"}]}], "铊": [{"tā": [{"e": "一种稀少而分布广泛的金属元素,外表与锡相似,但在空气中其表层容易形成为氧化物,展性如铅,但较软,产状以化合物形态见于少数矿物(例如硒铊银铜矿和红铊矿)内,毒性极大,主要以化合物的形式应用 ——元素符号Tl。"}]}], "铋": [{"bì": [{"e": "硬而脆的三价的金属元素,原子序数83 ——元素符号Bi。"}]}], "铌": [{"ní": [{"e": "一种具有极亮光泽的铂灰色韧性金属元素,主要为五价,产于铌铁矿及其他各种稀有矿物中;但总是伴随着钽(因为它们化学性质十分类似),钽可作为副产品被从中分离出来。铌主要用于合金中(如不锈钢中,少量的铌可防止晶间腐蚀) ——元素符号Nb。"}]}], "铍": [{"pī": [{"e": "兵器。双刃刀。一说是大矛。"}, {"e": "假借为“颇”。偏,不平正。"}]}, {"pí": [{"e": "钢灰色、轻、坚硬、质脆而有毒的二价金属元素,具有高电导率且X射线对它有高的贯穿能力,以化合物形式存在,可以从它的化合物还原生产(如通过电解),主要用在合金中做硬化剂(如与铜),在X射线管中用作窗并且在核反应堆中用作慢化剂和反射层 ——元素符号Be。"}]}], "铎": [{"duó": [{"e": "(形声。本义:大铃)。"}, {"e": "同本义。", "w": [{"w": "铎语", "t": "祭祀神灵时,用铎声节歌舞以祭"}, {"w": "铎头瘟", "t": "呆瘟神。"}]}, {"e": "挂在牛马颈下或屋檐下的小铃。"}, {"e": "刺;啄。"}]}], "氩": [{"yà": [{"e": "一种无色、无臭的惰性气体元素,存在于空气中,占空气体积的0.94%,亦存在于火山气体中,从液态空气分离获得。主要用于金属加工和电弧焊接时作为保护性气氛,还用于白炽电灯和荧光灯泡、充气电子管以及盖革计数管作填充气体 ——元素符号为A或Ar。"}]}], "氤": [{"yīn": [{"e": "ａ．烟云弥漫，如\"灵山多秀色，空水共氤氤\"；ｂ．中国哲学术语，指万物由相互作用而变化生长。"}]}], "氦": [{"hài": [{"e": "化学元素名。一种极轻的无色惰性气态元素,是所有气体中最难液化的,存在于整个宇宙中,但只在某些天然气中含有在经济上值得提取的量,主要用于填充飞艇和气球 ——元素符号He。"}]}], "毪": [{"mú": [{"e": "中国西藏出产的一种羊毛织品。即毪子。"}]}], "舐": [{"shì": [{"e": "(形声。从舌,氏声。本义:以舌舔物) 同本义。", "w": [{"w": "舐毫", "t": "古代传说雌兔用舌头舔舐雄兔的毛而怀孕"}, {"w": "舐笔", "t": "用舌头舔笔"}, {"w": "舐犊", "t": "老牛以舌舔小牛。比喻父母笃爱子女"}, {"w": "舐糠及米", "t": "舐食米糠后,续食糠内之米。比喻由外而内,逐渐蚕食"}, {"w": "舔足", "t": "吻舔人足"}, {"w": "火苗儿舐着锅底"}]}]}], "秣": [{"mò": [{"e": "(形声。从禾,末声。本义:喂马的谷饲料) 同本义(如干草、植物、谷草)。", "w": [{"w": "刍秣", "t": "刍为喂牛羊的草饲料;秣为喂马的谷饲料。"}]}]}], "秫": [{"shú": [{"e": "(象形。从古文术,加禾。本义:谷物之有粘性者。也指不粘者)。"}, {"e": "同本义。", "w": [{"w": "秫田", "t": "种植黏粟之田"}, {"w": "秫酒", "t": "用秫酿成的酒"}, {"w": "秫蘖", "t": "